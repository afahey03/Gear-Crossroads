{
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Jwt": {
        "Issuer": "GearCrossroads.Api",
        "Audience": "GearCrossroads.Client",
        "ExpiresInHours": 0.5
    },
    "App": {
        "FrontendBaseUrl": "https://gearcrossroads.com"
    },
    "Auth": {
        "RefreshTokenDays": 14
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}